{
  "name": "headscale-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:fetch": "node scripts/fetch-headscale-swagger.mjs",
    "api:convert": "swagger2openapi --outfile specs/headscale.openapi.json specs/headscale.swagger.json",
    "api:generate": "openapi-typescript specs/headscale.openapi.json -o src/api/generated/headscale.ts",
    "api:check": "pnpm api:convert && pnpm api:generate && git diff --exit-code -- specs/headscale.openapi.json src/api/generated/headscale.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@tanstack/vue-query": "^5.102.5",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "date-fns": "^4.4.0",
    "naive-ui": "^2.45.2",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
